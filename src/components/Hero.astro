---
import { personal } from "../config";
---

<section id="hero" data-section="hero" class="section section--transparent">
  <div class="hero-content">
    <!-- Overline label -->
    <span class="hero-overline animate-reveal stagger-1">
      <span class="hero-overline__dash"></span>
      Portfolio / 2025
    </span>

    <!-- Name — massive display type -->
    <h1 class="hero-name animate-reveal stagger-2">
      {personal.name}
    </h1>

    <!-- Role -->
    <p class="hero-role animate-reveal stagger-3">
      {personal.role}
    </p>

    <!-- Subtitle -->
    <p class="hero-subtitle animate-reveal stagger-4">
      {personal.subtitle}
    </p>

    <!-- Bio — monospace, asymmetric -->
    <div class="hero-bio animate-reveal stagger-5">
      <p>{personal.bio}</p>
    </div>

    <!-- Divider line -->
    <div class="hero-divider animate-reveal stagger-6">
      <div class="hero-divider__line"></div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <span class="scroll-indicator__line"></span>
    <span class="scroll-indicator__text">scroll</span>
  </div>
</section>

<style>
  .hero-content {
    max-width: 900px;
    position: relative;
  }

  .hero-overline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin-bottom: 2rem;
  }

  .hero-overline__dash {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: var(--color-accent-primary);
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw + 0.5rem, 9rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
    /* Brutalist: break out of container */
    margin-left: -0.06em;
  }

  .hero-role {
    font-family: var(--font-accent);
    font-size: clamp(1.1rem, 2vw, 1.75rem);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.2vw, 1rem);
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
  }

  .hero-bio {
    max-width: 560px;
    /* Asymmetric offset */
    margin-left: clamp(0rem, 3vw, 4rem);
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-border-hard);
  }

  .hero-bio p {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .hero-divider {
    margin-top: 3rem;
  }

  .hero-divider__line {
    width: clamp(80px, 15vw, 200px);
    height: 1px;
    background: var(--color-accent-primary);
    transform-origin: left;
    animation: line-grow 1s cubic-bezier(0.16, 1, 0.3, 1) 1s both;
  }

  /* Scroll indicator — bottom of viewport */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-indicator__line {
    display: block;
    width: 1px;
    height: 40px;
    background: var(--color-accent-primary);
    animation: scroll-hint 2s ease-in-out infinite;
  }

  .scroll-indicator__text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .hero-bio {
      margin-left: 0;
    }
  }
</style>
