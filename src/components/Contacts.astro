---
import { skillGroups, socials, personal } from "../config";
---

<section id="contacts" data-section="contacts" class="section section--overlay">
  <div class="contacts-container">
    <!-- Section header -->
    <div class="contacts-header animate-reveal">
      <span class="section-label">
        <span class="section-label__index">04</span>
        Contact
      </span>
      <h2 class="contacts-title">Let's<br /><em>Connect</em></h2>
    </div>

    <!-- Skills grid -->
    <div class="skills-section animate-reveal stagger-2">
      {skillGroups.map((group) => (
        <div class="skill-group">
          <h4 class="skill-group__label">{group.category}</h4>
          <div class="skill-group__tags">
            {group.skills.map((skill) => (
              <span class="skill-tag">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Divider -->
    <div class="contacts-divider animate-reveal stagger-3" aria-hidden="true">
      <div class="contacts-divider__line"></div>
    </div>

    <!-- Action buttons -->
    <div class="contacts-actions animate-reveal stagger-4">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="action-link"
          id={`link-${social.icon}`}
          aria-label={`Visit ${social.label}`}
        >
          <span class="action-link__label">{social.label}</span>
          <svg class="action-link__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
        </a>
      ))}

      <a
        href={personal.cvPath}
        download
        class="action-link action-link--primary"
        id="link-cv-download"
        aria-label="Download CV as PDF"
      >
        <span class="action-link__label">Download CV</span>
        <svg class="action-link__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3V11M8 11L4 7M8 11L12 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          <path d="M3 13H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </a>
    </div>

    <!-- Footer -->
    <footer class="site-footer animate-reveal stagger-5">
      <p class="footer-text">
        &copy; {new Date().getFullYear()} {personal.name}
      </p>
      <p class="footer-built">
        Built with <span class="text-accent">Astro</span> + <span class="text-accent">R3F</span>
      </p>
    </footer>
  </div>
</section>

<style>
  .contacts-container {
    max-width: 900px;
    width: 100%;
  }

  .contacts-header {
    margin-bottom: 3rem;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .section-label__index {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .contacts-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.95;
    color: var(--color-text-primary);
  }

  .contacts-title em {
    font-style: italic;
    color: var(--color-accent-primary);
  }

  /* Skills */
  .skills-section {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .skill-group__label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    font-weight: 400;
  }

  .skill-group__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border-hard);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .skill-tag:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  /* Divider */
  .contacts-divider {
    margin-bottom: 3rem;
  }

  .contacts-divider__line {
    width: 100%;
    height: 1px;
    background: var(--color-border-hard);
  }

  /* Action buttons */
  .contacts-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-border-hard);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .action-link:hover {
    border-color: var(--color-accent-info);
    color: var(--color-accent-info);
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--color-accent-info);
  }

  .action-link--primary {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: rgba(178, 75, 243, 0.08);
  }

  .action-link--primary:hover {
    background: rgba(178, 75, 243, 0.15);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 3px 3px 0 var(--color-accent-primary);
  }

  .action-link__arrow {
    transition: transform 0.3s ease;
  }

  .action-link:hover .action-link__arrow {
    transform: translate(2px, -2px);
  }

  .action-link--primary:hover .action-link__arrow {
    transform: translateY(2px);
  }

  /* Footer */
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-hard);
  }

  .footer-text,
  .footer-built {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .contacts-actions {
      flex-direction: column;
    }

    .action-link {
      justify-content: center;
    }

    .site-footer {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
