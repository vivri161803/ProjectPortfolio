---
import BaseLayout from "../layouts/BaseLayout.astro";
import CloseBanner from "../components/CloseBanner.astro";
import { personal, projects, facts, researchBand, pad } from "../data/site";
---

<BaseLayout grid={false}>
  <section class="poster">
    <div class="kicker">{personal.role} — {personal.location}</div>
    <h1>
      {personal.statement.lead}{" "}
      <span class="accent">{personal.statement.accent}</span>
    </h1>
  </section>

  <div class="facts">
    {
      facts.map((f) => (
        <div class="fact">
          <div class="kicker">{f.label}</div>
          <div class="fact-value">{f.value}</div>
        </div>
      ))
    }
    <div class="fact">
      <div class="kicker">Elsewhere</div>
      <div class="fact-value fact-links">
        <a href={personal.github}>GitHub ↗</a>
        <a href={personal.linkedin}>LinkedIn ↗</a>
      </div>
    </div>
  </div>

  <div class="band" aria-label="Research interests">
    <div class="band-track">
      {
        [0, 1].map(() => (
          <div class="band-run">
            {researchBand.map((t) => (
              <>
                <span>{t}</span>
                <span class="band-sep">/</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="section-head">
    <h2>Selected work</h2>
    <a class="section-link" href="/work">Full index →</a>
  </div>

  <div class="work-grid">
    {
      projects.map((p, i) => (
        <a class="cell" href={p.url} target="_blank" rel="noopener">
          <div class="cell-top">
            <span class="cell-area">{p.area}</span>
            <span class="cell-n">{pad(i)}</span>
          </div>
          <div class="cell-title">{p.title}</div>
          <p class="cell-desc">{p.desc}</p>
          <div class="cell-stack">{p.stack.join(" · ")}</div>
        </a>
      ))
    }
    <a class="cell cell-all" href={personal.github} target="_blank" rel="noopener">
      <div class="cell-title">All {personal.repoCount} repositories on GitHub ↗</div>
    </a>
    <div class="cell cell-filler"></div>
  </div>

  <CloseBanner />
</BaseLayout>
